package views

import "time"

type BlogPost struct {
	Slug        string
	Title       string
	Excerpt     string
	Body        string
	BodyHTML    string
	PublishedAt time.Time
}

templ BlogPage(posts []BlogPost) {
	<div class="mb-6">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h2 class="text-3xl font-bold">Blog ✍️</h2>
				<p class="text-base-content/70">Notes, updates, and longer thoughts from the site.</p>
			</div>
			<a href="/blog/rss.xml" class="btn btn-outline btn-primary btn-sm">RSS</a>
		</div>
	</div>

	<div class="grid gap-6">
		for _, post := range posts {
			<div class="card bg-base-100 shadow-xl">
				<div class="card-body">
					<h2 class="card-title">{ post.Title }</h2>
					<p class="text-md text-base-content/60">{ post.PublishedAt.Format("Monday, January 2, 2006") }</p>
					<p>{ post.Excerpt }</p>
					<div class="card-actions justify-end">
						<a href={ templ.URL("/blog/" + post.Slug) } class="btn btn-primary btn-sm">Read post</a>
					</div>
				</div>
			</div>
		}
	</div>
}

templ BlogPostPage(post BlogPost) {
	<div class="card bg-base-100 shadow-xl">
		<div class="card-body">
			<div class="flex items-start justify-between gap-4">
				<div>
					<h2 class="card-title text-3xl">{ post.Title }</h2>
					<p class="text-sm text-base-content/60">{ post.PublishedAt.Format("Monday, January 2, 2006") }</p>
				</div>
				<a href="/blog" class="btn btn-ghost btn-sm">Back to blog</a>
			</div>
			<div class="prose max-w-none">
				@templ.Raw(post.BodyHTML)
			</div>
		</div>
	</div>
}
