package views

templ ErrorPage(statusCode int, statusText string) {
	<div class="card mx-auto max-w-md bg-base-100 shadow-xl">
		<div class="card-body text-center">
			<h1 class="text-4xl font-bold">{statusCode} - {statusText}</h1>
			<div class="card-actions justify-center">
				<a href="/" class="btn btn-primary">Go back home</a>
			</div>
		</div>
	</div>
}